# Copy this file to .env and fill real values.
# Do NOT commit .env.
#
# Supabase Auth redirect: add `jike://auth/callback` in
# Supabase Dashboard -> Authentication -> URL Configuration.

# ===== App Required (client) =====
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_AMAP_KEY=YOUR_AMAP_JSAPI_KEY
EXPO_PUBLIC_AMAP_WEB_SERVICE_KEY=YOUR_AMAP_WEB_SERVICE_KEY

# ===== Map Native Plugin Keys (build-time) =====
# app.config.js prefers AMAP_ANDROID_KEY / AMAP_IOS_KEY.
# If empty, it falls back to EXPO_PUBLIC_AMAP_ANDROID_KEY / EXPO_PUBLIC_AMAP_IOS_KEY.
AMAP_ANDROID_KEY=
AMAP_IOS_KEY=
EXPO_PUBLIC_AMAP_ANDROID_KEY=
EXPO_PUBLIC_AMAP_IOS_KEY=

# ===== Optional App Tuning =====
EXPO_PUBLIC_AMAP_MAP_STYLE=
EXPO_PUBLIC_AI_TIMEOUT_SECONDS=60
EXPO_PUBLIC_TRACK_SAMPLE_INTERVAL_SECONDS=30
EXPO_PUBLIC_TRACK_SAMPLE_MIN_DISTANCE_M=80

# ===== Data Import / Admin Scripts =====
# Optional: used by scripts/gen-mcp-apply-json.cjs when URL is absent.
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
# Required by catalog import/replace scripts. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ===== Integration Test (optional) =====
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_QA_EMAIL=
TEST_QA_PASSWORD=
MAESTRO_TEST_EMAIL=
MAESTRO_TEST_PASSWORD=

# ===== Supabase Edge Function Secrets (set in Supabase, not in client bundle) =====
# Set via: supabase secrets set KEY=VALUE --project-ref YOUR_PROJECT_REF
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
TTS_API_TOKEN=
# Optional (has default in code):
TTS_API_BASE_URL=

# ===== Edge Runtime Built-ins (usually auto-injected by Supabase) =====
# Only needed for special local/debug setups.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Email Service (163)
SMTP_HOST=smtp.163.com
SMTP_PORT=
SMTP_USER=manbudezhu@163.com
SMTP_PASS=
SMTP_SECURE=true
SMTP_FROM=manbudezhu@163.com
