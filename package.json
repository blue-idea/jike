{
  "name": "bolt-expo-starter",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "build": "npm run build:web",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:auth": "node tests/auth-errors.test.mjs",
    "test:location": "node --import ./tests/test-register.mjs tests/location-next.test.mjs",
    "test:tts": "node --import ./tests/test-register.mjs tests/tts.test.mjs",
    "test:e2e-auth": "node scripts/auto-test-auth-e2e.cjs",
    "test:ai-itinerary": "node scripts/test-ai-itinerary-planning.cjs",
    "test:ai-chat": "node scripts/test-ai-chat.cjs",
    "test:ai-guide": "node scripts/test-ai-guide.cjs",
    "test:ai-travel-journal": "node scripts/test-ai-travel-journal.cjs",
    "data:china-regions": "node scripts/build-china-regions-from-xls.cjs",
    "data:catalog-import": "node scripts/import-catalog-from-xlsx.cjs",
    "prepare": "husky",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@expo/vector-icons": "^15.0.2",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@supabase/supabase-js": "^2.58.0",
    "expo": "^58.0.23",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "lucide-react-native": "^0.544.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "~4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.59.1",
    "@types/react": "~19.3.0",
    "@types/react-native": "^0.73.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "supabase": "^2.92.1",
    "typescript": "~5.9.2"
  }
}
