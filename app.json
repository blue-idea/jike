{
  "expo": {
    "name": "集刻",
    "slug": "jike",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/jike_logo_option_5_landscape_v2_1777199172924.png",
    "scheme": "jike",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许“集刻”访问你的位置，用于推荐附近文化点位与距离排序。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.manbudezhu.jike"
    }
  }
}
